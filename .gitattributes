# Normalize text to LF in the repo; let Git pick per-platform working-tree endings.
* text=auto

# Windows scripts always check out with CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf

# Never touch binaries.
*.png binary
*.ico binary
*.webp binary
*.jpg binary
*.gif binary
*.woff binary
*.woff2 binary

# Content-addressed fixtures: the file name IS the hash of the file's bytes, so
# checking them out with CRLF makes every hash wrong. The legacy-store importer
# then writes a blob whose text does not match its own hash, and the next
# INSERT OR IGNORE under that hash silently keeps the corrupt row.
ducky_app/backend/store/fixtures/legacy/blobs/*.txt -text
